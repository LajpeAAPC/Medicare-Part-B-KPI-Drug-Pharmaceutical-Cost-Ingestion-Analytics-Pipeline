import csv
import pandas as pd

# 1. Load the file using the exact header location found (index 3)
df = pd.read_excel(file_path, header=3)

# 2. FIX: Explicitly rename columns to ensure 100% database compatibility
df.columns = [
    "description",
    "hcpcs",
    "modifier",
    "allowed_services",
    "allowed_charges",
    "payment",
]
print("✅ Column names verified:", list(df.columns))

