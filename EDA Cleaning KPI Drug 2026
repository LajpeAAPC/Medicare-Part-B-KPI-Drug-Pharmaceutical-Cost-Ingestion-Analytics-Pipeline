# 3. ADVANCED AUDITING: Remove the duplicate 'TOTAL' rows to prevent double-counting
# Safely convert to string, remove extra spaces, and filter out 'TOTAL'
df["modifier"] = df["modifier"].astype(str).str.strip().str.upper()
df_no_totals = df[df["modifier"] != "TOTAL"].copy()
# 4. ENFORCE NUMERIC TYPES: Convert text metrics to floats safely
for col in ["allowed_services", "allowed_charges", "payment"]:
    df_no_totals[col] = pd.to_numeric(df_no_totals[col], errors="coerce")

# 4. ENFORCE NUMERIC TYPES: Convert text metrics to floats safely
for col in ["allowed_services", "allowed_charges", "payment"]:
    df_no_totals[col] = pd.to_numeric(df_no_totals[col], errors="coerce")

# 5. FILTER OUTLIERS: Keep only rows where transactions actually occurred
df_cleaned = df_no_totals[
    (df_no_totals["allowed_services"] > 0)
    & (df_no_totals["allowed_charges"] > 0)
    & (df_no_totals["payment"] > 0)
].dropna(subset=["hcpcs"])

# 6. Print validation summary for your portfolio documentation
print(f"\nTotal raw rows in spreadsheet: {len(df)}")
print(f"Cleaned data rows kept: {len(df_cleaned)}")
print(f"Total summary rows/anomalies removed: {len(df) - len(df_cleaned)}")

